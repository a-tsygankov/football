node_modules/
dist/
build/
.wrangler/
.output/
.cache/
coverage/

# env / secrets
.env
.env.local
.env.*.local
.dev.vars

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test output
*.lcov

# TypeScript build info
*.tsbuildinfo

# Claude Code local settings (per-developer, not shared)
.claude/settings.local.json

# Ephemeral agent worktrees. One of these was previously committed as a
# gitlink (mode 160000) with no matching .gitmodules entry, which made
# actions/checkout fail its post-job cleanup with exit 128 on every CI run.
.claude/worktrees/

# Python bytecode (version tooling in scripts/)
__pycache__/
*.py[cod]

# Assembled by CI from apps/web/dist + site-root; never committed.
workers/*/site/

# Playwright output
/test-results/
/playwright-report/
